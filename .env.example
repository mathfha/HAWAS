# Frontend Vite
VITE_HAWAS_API_BASE_URL=http://localhost:8080

# Backend Cloud Run atau pengembangan lokal
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# Pilih salah satu: Gemini API key atau autentikasi Vertex AI.
GEMINI_API_KEY=ganti-dengan-api-key-gemini
GOOGLE_CLOUD_PROJECT=nama-project-google-cloud
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=15000
