{
  "name": "hawas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:server && vite build",
    "start:api": "node dist-server/server/index.js",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "qr-scanner": "1.4.2"
  }
}
